# ==========================================================
# THE SILENT CO-DRIVER — backend configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. NEVER expose these values to the frontend.
# ==========================================================

# --- OpenF1 (public, historical endpoints require no key today) ---
OPENF1_BASE_URL=https://api.openf1.org/v1

# --- Demo / fallback mode ---
# When true, EVERY route (meetings/sessions/drivers/laps/audio/etc.)
# returns a single fixed demo dataset regardless of what you select —
# that's why every year/session looks identical in demo mode. Set this
# to false once your model API is ready, so selections hit real OpenF1
# data and your real model.
DEMO_MODE=false

# --- Your external model API ---
# The backend POSTs the radio audio + F1 context to this URL and
# expects one JSON response with the transcript + vocal state.
# Full request/response contract documented in:
#   backend/app/services/model_service.py
MODEL_API_URL=
MODEL_API_KEY=
MODEL_API_TIMEOUT_SECONDS=30

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Audio handling ---
MAX_AUDIO_MB=25
